#include<stdio.h>
int main()
{
   int i,j,n,a[100],t;
   printf("Enter number of elements");
   scanf("%d",&n);
   printf("Enter the elements");
   for(i=0;i<n;i++)
   {
      scanf("%d",&a[i]);
   }
  for(i=0;i<n;i++)
  {
     for(j=0;j<n;j++)
     {
        if(a[j]>a[j+1])
        {
           t=a[j];
           a[j]=a[j+1];
           a[j+1]=t;
        }
     }
  }
  printf("Second largest element is:%d",a[n-2]);
  return 0;
}
