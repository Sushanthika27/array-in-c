#include<stdio.h>
int main()
{
   int n,i,a[100],m;
   printf("Enter the number of elements");
   scanf("%d",&n);
   printf("Enter the elements");
   for(i=0;i<n;i++)
      scanf("%d",&a[i]);
   m=a[0];
   for(i=1;i<n;i++)
   {
      if(a[i]>m)
         m=a[i];
   }
   printf("\nThe max element is%d",m);
   return 0;
}
