#include<stdio.h>
int main()
{
   int i,a[100],key,n,f=0;
   printf("Enter the number of elements");
   scanf("%d",&n);
   printf("Enter the key to be searched");
    scanf("%d",&key);
   printf("Enter the elements");
   for(i=0;i<n;i++)
   {
      scanf("%d",&a[i]);
   }
   for(i=0;i<n;i++)
   {
      if(a[i]==key)
      {
         f=1;
         printf("The element is found at index:%d",i);
         break;
      }
   }
      if(f==0)
      {
         printf("The element is not found");
      }
   return 0;
}
