#include<stdio.h>
int main()
{
   int num[100],sum=0;
   int n,i;
   printf("Enter Total Number Of Students");
   scanf("%d",&n);
   printf("Enter Marks");
   for(i=0;i<n;i++)
   {
      scanf("%d",&num[i]);
      if(num[i]%2!=0)
      {
         sum+=num[i];
      }
   }
   printf("Summ Odd Marks Is;%d",sum);
   return 0;
}
